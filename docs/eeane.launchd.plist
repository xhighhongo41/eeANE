<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.eeane.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/.local/bin/eeane</string>
		<string>serve</string>
		<string>--config</string>
		<string>/Users/USERNAME/path/to/eeane.toml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/Library/Logs/eeane/eeane.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/eeane/eeane.log</string>
</dict>
</plist>
